# İlk kurulumda kopyalayın: Copy-Item .env.example .env
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/dersatlas.db
# SQL Server alternatifi (ODBC Driver 18 ve pyodbc gerekir):
# DATABASE_URL=mssql+pyodbc://dersatlas:URL_ENCODED_PASSWORD@localhost/DersAtlas?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:4b
EMBED_MODEL=bge-m3
# Boş ise gömülü, kalıcı Qdrant; Docker'da http://qdrant:6333.
QDRANT_URL=
QDRANT_API_KEY=
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SESSION_HOURS=8
MAX_UPLOAD_MB=20
MAX_PAGES=300
CHUNK_CHARS=1600
CHUNK_OVERLAP=220
DENSE_THRESHOLD=0.35
TOP_K=6
OLLAMA_TIMEOUT=180
AGENT_MAX_ROUNDS=3
WORKER_ENABLED=true

